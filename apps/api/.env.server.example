# 此文件只作为公司服务端环境变量模板；复制到部署系统的密钥管理或 EnvironmentFile，切勿提交真实密钥。
NODE_ENV=production
PORT=3001

# 前端实际访问来源。CORS_ORIGINS 为空时会沿用开发兼容行为（反射所有来源）；生产必须填写明确的 HTTPS 来源，可逗号分隔。
WEB_ORIGIN=https://game.example.com
CORS_ORIGINS=https://game.example.com

# 仅影响 POST /api/generate-level 未显式传 mode 时的默认值。
# “新建冒险”的 POST /api/commission/stage 始终需要下方 AI 网关配置。
GENERATOR_MODE=openai

# 文本大模型：仅由 API 进程读取，绝不写入前端环境变量。
AI_GATEWAY_BASE_URL=https://ai-gateway.aiae.ndhy.com/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-5.5-2026-04-24
AI_GATEWAY_TIMEOUT_MS=60000
AI_CODE_TIMEOUT_MS=75000

# 持久化：单实例 JSON 存储。挂载到持久卷，API 多副本前需改为共享数据库/对象存储。
API_DATA_DIR=/srv/hidden-object-api/data

# 已完成的图片/视频写入此目录；反向代理或对象存储必须将此目录映射到 GENERATED_ASSET_PUBLIC_BASE。
GENERATED_ASSET_DIR=/srv/hidden-object-api/generated-assets
GENERATED_ASSET_PUBLIC_BASE=/content/commissions

# 仅启用 AIHub 图片资产生产时需要。当前实现还需要 PowerShell 7 及包含 appId 注册表的 AIHub Skill 目录；
# 文本大模型、关卡生成、草稿和事件 API 不依赖这些变量。
AIHUB_AGENT_TOKEN=
AIHUB_ASSET_SKILL_DIR=/opt/aihub-asset-production
AIHUB_POWERSHELL_PATH=pwsh
